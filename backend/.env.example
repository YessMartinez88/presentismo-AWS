# Copiá este archivo a .env y ajustá los valores. .env NO se sube al repositorio.
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Secretos de firma (usá valores largos y distintos entre sí; en AWS van en Secrets Manager / SSM)
JWT_SECRET=cambiar-por-un-secreto-largo
QR_SECRET=cambiar-por-otro-secreto-largo

# --- QR ---
# El QR que ve el alumno es un token firmado que vence a los QR_TOKEN_TTL_SECONDS
# (el docente lo renueva cada QR_REFRESH_SECONDS). La sesión dura SESSION_DEFAULT_MINUTES salvo que el docente elija otra.
QR_TOKEN_TTL_SECONDS=40
QR_REFRESH_SECONDS=20
SESSION_DEFAULT_MINUTES=10

# Zona horaria (nombre Windows de SQL Server) para calcular la "fecha" de la clase
APP_TIMEZONE=Argentina Standard Time

# --- Base de datos ---
DB_NAME=presentismo
DB_SERVER=.\SQLEXPRESS
# Local: sin DB_USER/DB_PASSWORD se usa autenticación de Windows (driver msnodesqlv8).
# AWS RDS: definir DB_USER y DB_PASSWORD (y DB_PORT si no es 1433) y se usa el driver TCP (tedious).
# DB_USER=
# DB_PASSWORD=
# DB_PORT=1433
