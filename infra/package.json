{
  "name": "presentismo-infra",
  "version": "0.1.0",
  "private": true,
  "description": "Infraestructura como código (AWS CDK): Amplify Hosting + API Gateway + Lambda + DynamoDB",
  "scripts": {
    "bootstrap": "cdk bootstrap",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "crear-clave": "tsx scripts/crear-clave.ts",
    "deploy": "tsx scripts/crear-clave.ts && cdk deploy --require-approval never --outputs-file cdk-outputs.json",
    "deploy:frontend": "tsx scripts/deploy-frontend.ts",
    "destroy": "cdk destroy"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@aws-sdk/client-amplify": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.0",
    "adm-zip": "^0.5.16",
    "aws-cdk": "^2.1000.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
